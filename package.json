    "@wallet-standard/app": "^1.1.0",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "gsap": "^3.15.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/bn.js": "^5.2.0",
    "@types/node": "^26.6.6",
    "@wallet-standard/base": "^1.1.0",
    "tsx": "^4.23.15",
    "tweetnacl": "^1.0.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  }
